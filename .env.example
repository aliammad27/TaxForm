# Supabase (local dev values come from `npx supabase start` output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (used by ingestion scripts)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Anthropic
ANTHROPIC_API_KEY=

# Cron jobs (Vercel)
CRON_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=TaxForm <notifications@taxform.app>

# Site URL (auth redirects, referral links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Embeddings (optional — falls back to hashing)
VOYAGE_API_KEY=

# Rate limiting (optional — falls back to Postgres)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe billing (optional — billing disabled when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DIY_FLAT_FEE_CENTS=4900
STRIPE_CONTINGENCY_PCT=0.25

# Sentry (optional — monitoring disabled when unset)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
